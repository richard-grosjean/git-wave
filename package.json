{
  "name": "git-wave",
  "displayName": "Git Wave",
  "description": "A fast git graph with worktrees. Lightweight, canvas-drawn history with lock-aware worktree management.",
  "version": "0.3.0",
  "publisher": "rgro",
  "license": "MIT",
  "author": {
    "name": "Richard Grosjean"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richard-grosjean/git-wave.git"
  },
  "bugs": {
    "url": "https://github.com/richard-grosjean/git-wave/issues"
  },
  "homepage": "https://github.com/richard-grosjean/git-wave#readme",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "worktree",
    "branch",
    "history"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "badges": [
    {
      "url": "https://github.com/richard-grosjean/git-wave/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/richard-grosjean/git-wave/actions/workflows/ci.yml",
      "description": "CI"
    }
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "workspaceContains:**/.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitwave.open",
        "title": "Open Graph",
        "category": "Git Wave",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitwave.refresh",
        "title": "Refresh Graph",
        "category": "Git Wave",
        "icon": "$(refresh)"
      },
      {
        "command": "gitwave.worktrees.refresh",
        "title": "Refresh Worktrees",
        "category": "Git Wave",
        "icon": "$(refresh)"
      },
      {
        "command": "gitwave.worktree.add",
        "title": "Add Worktree…",
        "category": "Git Wave",
        "icon": "$(add)"
      },
      {
        "command": "gitwave.worktree.prune",
        "title": "Prune Worktrees",
        "category": "Git Wave",
        "icon": "$(trash)"
      },
      {
        "command": "gitwave.worktree.lock",
        "title": "Lock Worktree…",
        "category": "Git Wave",
        "icon": "$(lock)"
      },
      {
        "command": "gitwave.worktree.unlock",
        "title": "Unlock Worktree",
        "category": "Git Wave",
        "icon": "$(unlock)"
      },
      {
        "command": "gitwave.worktree.remove",
        "title": "Remove Worktree",
        "category": "Git Wave",
        "icon": "$(close)"
      },
      {
        "command": "gitwave.worktree.open",
        "title": "Open Worktree in Current Window",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.worktree.openNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Git Wave",
        "icon": "$(empty-window)"
      },
      {
        "command": "gitwave.worktree.copyPath",
        "title": "Copy Worktree Path",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.worktree.revealInGraph",
        "title": "Reveal in Git Wave",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.fetch",
        "title": "Fetch All Remotes",
        "category": "Git Wave",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitwave.commit.checkout",
        "title": "Checkout Commit (Detached)",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.createBranch",
        "title": "Create Branch Here…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.createTag",
        "title": "Create Tag Here…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.cherryPick",
        "title": "Cherry-pick Commit…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.revert",
        "title": "Revert Commit…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.merge",
        "title": "Merge Commit into Current Branch…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.reset",
        "title": "Reset Current Branch to Here…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.copyHash",
        "title": "Copy Commit Hash",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.commit.copySubject",
        "title": "Copy Commit Subject",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.checkout",
        "title": "Checkout Branch",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.merge",
        "title": "Merge into Current Branch…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.rebase",
        "title": "Rebase Current Branch onto This…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.createFrom",
        "title": "Create Branch from Here…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.rename",
        "title": "Rename Branch…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.delete",
        "title": "Delete Branch…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.branch.copyName",
        "title": "Copy Branch Name",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.tag.checkout",
        "title": "Checkout Tag (Detached)",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.tag.delete",
        "title": "Delete Tag…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.tag.copyName",
        "title": "Copy Tag Name",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.stash.apply",
        "title": "Apply Stash",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.stash.pop",
        "title": "Pop Stash",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.stash.drop",
        "title": "Drop Stash…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.open",
        "title": "Open Worktree in Current Window",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.openNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.lock",
        "title": "Lock Worktree…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.unlock",
        "title": "Unlock Worktree",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.remove",
        "title": "Remove Worktree…",
        "category": "Git Wave"
      },
      {
        "command": "gitwave.ctx.worktree.copyPath",
        "title": "Copy Worktree Path",
        "category": "Git Wave"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitwave.worktrees",
          "name": "Worktrees",
          "icon": "$(folder-library)",
          "contextualTitle": "Git Wave Worktrees",
          "when": "gitwave.hasRepo"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitwave.worktrees",
        "contents": "No worktrees found.\n[Add Worktree](command:gitwave.worktree.add)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitwave.open",
          "group": "navigation@1",
          "when": "gitwave.hasRepo"
        }
      ],
      "view/title": [
        {
          "command": "gitwave.worktree.add",
          "when": "view == gitwave.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitwave.open",
          "when": "view == gitwave.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "gitwave.worktrees.refresh",
          "when": "view == gitwave.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "gitwave.worktree.prune",
          "when": "view == gitwave.worktrees",
          "group": "1_manage"
        }
      ],
      "view/item/context": [
        {
          "command": "gitwave.worktree.unlock",
          "when": "view == gitwave.worktrees && viewItem =~ /locked/",
          "group": "inline@1"
        },
        {
          "command": "gitwave.worktree.lock",
          "when": "view == gitwave.worktrees && viewItem =~ /unlocked/ && viewItem =~ /linked/",
          "group": "inline@1"
        },
        {
          "command": "gitwave.worktree.openNewWindow",
          "when": "view == gitwave.worktrees",
          "group": "inline@2"
        },
        {
          "command": "gitwave.worktree.open",
          "when": "view == gitwave.worktrees",
          "group": "1_open@1"
        },
        {
          "command": "gitwave.worktree.openNewWindow",
          "when": "view == gitwave.worktrees",
          "group": "1_open@2"
        },
        {
          "command": "gitwave.worktree.revealInGraph",
          "when": "view == gitwave.worktrees",
          "group": "1_open@3"
        },
        {
          "command": "gitwave.worktree.lock",
          "when": "view == gitwave.worktrees && viewItem =~ /unlocked/ && viewItem =~ /linked/",
          "group": "2_lock@1"
        },
        {
          "command": "gitwave.worktree.unlock",
          "when": "view == gitwave.worktrees && viewItem =~ /locked/",
          "group": "2_lock@1"
        },
        {
          "command": "gitwave.worktree.copyPath",
          "when": "view == gitwave.worktrees",
          "group": "3_misc@1"
        },
        {
          "command": "gitwave.worktree.remove",
          "when": "view == gitwave.worktrees && viewItem =~ /linked/",
          "group": "4_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitwave.worktree.lock",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.unlock",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.remove",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.open",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.openNewWindow",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.copyPath",
          "when": "false"
        },
        {
          "command": "gitwave.worktree.revealInGraph",
          "when": "false"
        },
        {
          "command": "gitwave.commit.checkout",
          "when": "false"
        },
        {
          "command": "gitwave.commit.createBranch",
          "when": "false"
        },
        {
          "command": "gitwave.commit.createTag",
          "when": "false"
        },
        {
          "command": "gitwave.commit.cherryPick",
          "when": "false"
        },
        {
          "command": "gitwave.commit.revert",
          "when": "false"
        },
        {
          "command": "gitwave.commit.merge",
          "when": "false"
        },
        {
          "command": "gitwave.commit.reset",
          "when": "false"
        },
        {
          "command": "gitwave.commit.copyHash",
          "when": "false"
        },
        {
          "command": "gitwave.commit.copySubject",
          "when": "false"
        },
        {
          "command": "gitwave.branch.checkout",
          "when": "false"
        },
        {
          "command": "gitwave.branch.merge",
          "when": "false"
        },
        {
          "command": "gitwave.branch.rebase",
          "when": "false"
        },
        {
          "command": "gitwave.branch.createFrom",
          "when": "false"
        },
        {
          "command": "gitwave.branch.rename",
          "when": "false"
        },
        {
          "command": "gitwave.branch.delete",
          "when": "false"
        },
        {
          "command": "gitwave.branch.copyName",
          "when": "false"
        },
        {
          "command": "gitwave.tag.checkout",
          "when": "false"
        },
        {
          "command": "gitwave.tag.delete",
          "when": "false"
        },
        {
          "command": "gitwave.tag.copyName",
          "when": "false"
        },
        {
          "command": "gitwave.stash.apply",
          "when": "false"
        },
        {
          "command": "gitwave.stash.pop",
          "when": "false"
        },
        {
          "command": "gitwave.stash.drop",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.open",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.openNewWindow",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.lock",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.unlock",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.remove",
          "when": "false"
        },
        {
          "command": "gitwave.ctx.worktree.copyPath",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "gitwave.commit.checkout",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "1_nav@1"
        },
        {
          "command": "gitwave.commit.createBranch",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "1_nav@2"
        },
        {
          "command": "gitwave.commit.createTag",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "1_nav@3"
        },
        {
          "command": "gitwave.commit.merge",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "2_integrate@1"
        },
        {
          "command": "gitwave.commit.cherryPick",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "2_integrate@2"
        },
        {
          "command": "gitwave.commit.revert",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "2_integrate@3"
        },
        {
          "command": "gitwave.commit.reset",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "3_danger@1"
        },
        {
          "command": "gitwave.commit.copyHash",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "9_copy@1"
        },
        {
          "command": "gitwave.commit.copySubject",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'commit'",
          "group": "9_copy@2"
        },
        {
          "command": "gitwave.branch.checkout",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch' && !isHead",
          "group": "1_nav@1"
        },
        {
          "command": "gitwave.branch.merge",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch' && !isHead",
          "group": "2_integrate@1"
        },
        {
          "command": "gitwave.branch.rebase",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch' && !isHead",
          "group": "2_integrate@2"
        },
        {
          "command": "gitwave.branch.createFrom",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch'",
          "group": "1_nav@2"
        },
        {
          "command": "gitwave.branch.rename",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch'",
          "group": "3_edit@1"
        },
        {
          "command": "gitwave.branch.delete",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch' && !isHead",
          "group": "3_edit@2"
        },
        {
          "command": "gitwave.branch.copyName",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'branch'",
          "group": "9_copy@1"
        },
        {
          "command": "gitwave.branch.checkout",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'remote'",
          "group": "1_nav@1"
        },
        {
          "command": "gitwave.branch.merge",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'remote'",
          "group": "2_integrate@1"
        },
        {
          "command": "gitwave.branch.rebase",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'remote'",
          "group": "2_integrate@2"
        },
        {
          "command": "gitwave.branch.createFrom",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'remote'",
          "group": "1_nav@2"
        },
        {
          "command": "gitwave.branch.copyName",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'remote'",
          "group": "9_copy@1"
        },
        {
          "command": "gitwave.tag.checkout",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'tag'",
          "group": "1_nav@1"
        },
        {
          "command": "gitwave.branch.createFrom",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'tag'",
          "group": "1_nav@2"
        },
        {
          "command": "gitwave.commit.merge",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'tag'",
          "group": "2_integrate@1"
        },
        {
          "command": "gitwave.tag.delete",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'tag'",
          "group": "3_edit@1"
        },
        {
          "command": "gitwave.tag.copyName",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'tag'",
          "group": "9_copy@1"
        },
        {
          "command": "gitwave.stash.apply",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'stash'",
          "group": "1_stash@1"
        },
        {
          "command": "gitwave.stash.pop",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'stash'",
          "group": "1_stash@2"
        },
        {
          "command": "gitwave.stash.drop",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'stash'",
          "group": "3_danger@1"
        },
        {
          "command": "gitwave.ctx.worktree.openNewWindow",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree'",
          "group": "1_open@1"
        },
        {
          "command": "gitwave.ctx.worktree.open",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree'",
          "group": "1_open@2"
        },
        {
          "command": "gitwave.ctx.worktree.lock",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree' && !locked && !isMain",
          "group": "2_lock@1"
        },
        {
          "command": "gitwave.ctx.worktree.unlock",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree' && locked",
          "group": "2_lock@1"
        },
        {
          "command": "gitwave.ctx.worktree.copyPath",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree'",
          "group": "9_copy@1"
        },
        {
          "command": "gitwave.ctx.worktree.remove",
          "when": "webviewId == 'gitwave.graph' && webviewSection == 'worktree' && !isMain",
          "group": "4_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "Git Wave",
      "properties": {
        "gitwave.commitsPerPage": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "Commits fetched per page. More are loaded as you scroll."
        },
        "gitwave.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Include remote-tracking branches in the graph."
        },
        "gitwave.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Include tags in the graph."
        },
        "gitwave.dateFormat": {
          "type": "string",
          "enum": [
            "relative",
            "absolute",
            "iso"
          ],
          "default": "relative",
          "description": "How commit dates are displayed."
        },
        "gitwave.graph.laneWidth": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "Horizontal pixels per graph lane."
        },
        "gitwave.graph.rowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 16,
          "maximum": 48,
          "description": "Row height in pixels."
        },
        "gitwave.graph.colors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#4e9bff",
            "#f78166",
            "#56d364",
            "#e3b341",
            "#bc8cff",
            "#39c5cf",
            "#ff7eb6",
            "#8ab4f8",
            "#d2a8ff",
            "#7ee787"
          ],
          "description": "Lane colors, cycled in order."
        },
        "gitwave.avatars": {
          "type": "boolean",
          "default": true,
          "description": "Show author avatars (GitHub via the gh CLI token when available, otherwise Gravatar)."
        },
        "gitwave.graph.visibleLanes": {
          "type": "number",
          "default": 12,
          "minimum": 3,
          "maximum": 64,
          "description": "Lanes visible in the graph column before it scrolls horizontally."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vscode/codicons": "^0.0.36",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
